# Copy this file to .env and fill in your secrets.
# In GitHub Actions, these become repo secrets (Settings -> Secrets and variables -> Actions).

# --- Required: Farcaster (Neynar) ---
NEYNAR_API_KEY=
NEYNAR_SIGNER_UUID=

# --- Required: LLM (OpenAI) ---
OPENAI_API_KEY=
# Optional: override the default model
OPENAI_MODEL=gpt-4o-mini

# --- Optional: Twitter source selection ---
# Available: xcancel | apify | fixture
TWITTER_SOURCE=xcancel

# --- Optional: Apify (only if TWITTER_SOURCE=apify) ---
APIFY_TOKEN=
APIFY_ACTOR_ID=apidojo/tweet-scraper

# --- Optional: post to a specific Farcaster channel (e.g. "alpha", "crypto") ---
# Leave blank to post to your home feed.
FARCASTER_CHANNEL_ID=

# --- Optional: behavior tuning ---
# Probability per cron tick that we actually post (0.0 - 1.0).
# With cron every hour for 18 active hours and POST_PROBABILITY=0.5 you get ~9 posts/day.
POST_PROBABILITY=0.5
# Active hours window (UTC, 24h). Bot only posts within this range.
ACTIVE_HOURS_START_UTC=2
ACTIVE_HOURS_END_UTC=20
# Min/max post length (Farcaster cast limit is 1024 bytes).
MIN_LENGTH=80
MAX_LENGTH=320
# Look back this many hours for source tweets.
LOOKBACK_HOURS=24
# Dry run: print what would be posted without calling Neynar.
DRY_RUN=false
